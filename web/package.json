{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:exam-bank": "node scripts/generate-exam-bank.mjs",
    "generate:comprehensive-exams": "node scripts/generate-exam-bank.mjs --start-exam=11 --count=10 --all-days",
    "prepare:data": "node scripts/prepare-data.mjs",
    "prebackfill:answers": "npm run prepare:data",
    "backfill:answers": "node scripts/backfill-answer-keys.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite",
    "prebuild": "npm run prepare:data",
    "build": "tsc -b && vite build",
    "pretest": "npm run prepare:data",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
